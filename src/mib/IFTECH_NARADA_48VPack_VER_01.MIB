IFTECH-NARADABMSSYSTEM-MIB DEFINITIONS ::= BEGIN

IMPORTS
    RowStatus, DisplayString, DateAndTime
        FROM SNMPv2-TC
    enterprises, MODULE-IDENTITY, OBJECT-TYPE, Unsigned32, IpAddress, NOTIFICATION-TYPE, Integer32
        FROM SNMPv2-SMI
    OBJECT-GROUP, MODULE-COMPLIANCE
        FROM SNMPv2-CONF;

-- MODULE-IDENTITY definition
batModule MODULE-IDENTITY
    LAST-UPDATED    "202412140000Z"
    ORGANIZATION    "IFTECH FOR BATTERY Management System"
    CONTACT-INFO    "mvcjhkim@gmail.com"
    DESCRIPTION     "This MIB module defines objects for 11-module BMS management from IFTECH with enhanced monitoring capabilities."
    REVISION        "202412140000Z"
    DESCRIPTION     "Updated version with 10 modules supporting cell voltage, temperature, alarm and parameter monitoring."
    ::= { enterprises 64016 }

-- Define the main OID branches for 10 modules
bmsModule1 OBJECT IDENTIFIER ::= { batModule 1 }
bmsModule2 OBJECT IDENTIFIER ::= { batModule 2 }
bmsModule3 OBJECT IDENTIFIER ::= { batModule 3 }
bmsModule4 OBJECT IDENTIFIER ::= { batModule 4 }
bmsModule5 OBJECT IDENTIFIER ::= { batModule 5 }
bmsModule6 OBJECT IDENTIFIER ::= { batModule 6 }
bmsModule7 OBJECT IDENTIFIER ::= { batModule 7 }
bmsModule8 OBJECT IDENTIFIER ::= { batModule 8 }
bmsModule9 OBJECT IDENTIFIER ::= { batModule 9 }
bmsModule10 OBJECT IDENTIFIER ::= { batModule 10 }

-- Common structure for each module
-- Module 1 Objects
module1CellVoltage OBJECT IDENTIFIER ::= { bmsModule1 1 }
module1Temperature OBJECT IDENTIFIER ::= { bmsModule1 2 }
module1PackInfo OBJECT IDENTIFIER ::= { bmsModule1 3 }
module1Alarms OBJECT IDENTIFIER ::= { bmsModule1 4 }
module1Parameters OBJECT IDENTIFIER ::= { bmsModule1 5 }

-- Module 1 Cell Voltages (16 cells)
mod1-cell1-voltage OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "mV"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Cell 1 voltage value in mV (0-5000)"
    ::= { module1CellVoltage 1 }

mod1-cell2-voltage OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "mV"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Cell 2 voltage value in mV"
    ::= { module1CellVoltage 2 }

