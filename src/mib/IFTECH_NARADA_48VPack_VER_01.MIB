    SYNTAX          Integer32
    UNITS           "Celsius"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Ambient Temperature"
    ::= { module1Temperature 7 }

-- Module 1 Pack Information
mod1-cell-max-voltage OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "mV"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Maximum cell voltage in pack (0-5000 mV)"
    ::= { module1PackInfo 1 }

mod1-cell-min-voltage OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "mV"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Minimum cell voltage in pack"
    ::= { module1PackInfo 2 }

mod1-cell-avg-voltage OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "mV"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Average cell voltage"
    ::= { module1PackInfo 3 }

mod1-max-temp OBJECT-TYPE
    SYNTAX          Integer32
    UNITS           "Celsius"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Maximum temperature in pack"
    ::= { module1PackInfo 4 }

mod1-min-temp OBJECT-TYPE
    SYNTAX          Integer32
    UNITS           "Celsius"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Minimum temperature in pack"
    ::= { module1PackInfo 5 }

mod1-total-voltage OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "V"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Total battery pack voltage (0-7000 V, display as V/100)"
    ::= { module1PackInfo 6 }

mod1-pack-voltage OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "V"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Pack voltage value"
    ::= { module1PackInfo 7 }

mod1-charge-current OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "A"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Battery pack charge current (0-60000, display as A/100)"
    ::= { module1PackInfo 8 }

mod1-discharge-current OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "A"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Battery pack discharge current"
    ::= { module1PackInfo 9 }

mod1-soc OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "percent"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 State of Charge (0-100%)"
    ::= { module1PackInfo 10 }

mod1-soh OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "percent"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 State of Health (0-100%)"
    ::= { module1PackInfo 11 }

mod1-rated-capacity OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "AH"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Rated capacity (10-65000 AH, display as AH/100)"
    ::= { module1PackInfo 12 }

mod1-remaining-capacity OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "AH"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Remaining capacity"
    ::= { module1PackInfo 13 }

mod1-running-state OBJECT-TYPE
    SYNTAX          Integer32 (1..3)
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Running state: 1=Charge, 2=Discharge, 3=Stop"
    ::= { module1PackInfo 14 }

-- Module 1 Alarm Status (read-only alarms)
mod1-cell-overvoltage-alarms OBJECT-TYPE
    SYNTAX          Unsigned32
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Cell overvoltage alarms (bit field for cells 1-16)"
    ::= { module1Alarms 1 }

mod1-cell-undervoltage-alarms OBJECT-TYPE
    SYNTAX          Unsigned32
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Cell undervoltage alarms (bit field for cells 1-16)"
    ::= { module1Alarms 2 }

mod1-temp-charge-overheat-alarms OBJECT-TYPE
    SYNTAX          Unsigned32
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Temperature charge overheat alarms"
    ::= { module1Alarms 3 }

mod1-temp-charge-underheat-alarms OBJECT-TYPE
    SYNTAX          Unsigned32
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Temperature charge underheat alarms"
    ::= { module1Alarms 4 }

mod1-temp-discharge-overheat-alarms OBJECT-TYPE
    SYNTAX          Unsigned32
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Temperature discharge overheat alarms"
    ::= { module1Alarms 5 }

mod1-temp-discharge-underheat-alarms OBJECT-TYPE
    SYNTAX          Unsigned32
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Temperature discharge underheat alarms"
    ::= { module1Alarms 6 }

mod1-pack-overvoltage-alarm OBJECT-TYPE
    SYNTAX          Integer32 (0..1)
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Pack overvoltage alarm: 0=Normal, 1=Alarm"
    ::= { module1Alarms 7 }

mod1-pack-undervoltage-alarm OBJECT-TYPE
    SYNTAX          Integer32 (0..1)
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Pack undervoltage alarm: 0=Normal, 1=Alarm"
    ::= { module1Alarms 8 }

mod1-charge-overcurrent-alarm OBJECT-TYPE
    SYNTAX          Integer32 (0..1)
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Charge overcurrent alarm: 0=Normal, 1=Alarm"
    ::= { module1Alarms 9 }

mod1-discharge-overcurrent-alarm OBJECT-TYPE
    SYNTAX          Integer32 (0..1)
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Discharge overcurrent alarm: 0=Normal, 1=Alarm"
    ::= { module1Alarms 10 }

mod1-soc-low-alarm OBJECT-TYPE
    SYNTAX          Integer32 (0..1)
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 SOC low alarm: 0=Normal, 1=Alarm"
    ::= { module1Alarms 11 }

-- Module 1 Parameters (read-write configuration)
mod1-cell-overvoltage-alarm-value OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "V"
    MAX-ACCESS      read-write
    STATUS          current
    DESCRIPTION     "Module 1 Cell overvoltage alarm threshold (3000-4200, display as V/1000)"
    ::= { module1Parameters 1 }

mod1-cell-overvoltage-alarm-recovery OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "V"
    MAX-ACCESS      read-write
    STATUS          current
    DESCRIPTION     "Module 1 Cell overvoltage alarm recovery threshold"
    ::= { module1Parameters 2 }

mod1-cell-undervoltage-alarm-value OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "V"
    MAX-ACCESS      read-write
    STATUS          current
    DESCRIPTION     "Module 1 Cell undervoltage alarm threshold"
    ::= { module1Parameters 3 }

mod1-cell-undervoltage-alarm-recovery OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "V"
    MAX-ACCESS      read-write
    STATUS          current
    DESCRIPTION     "Module 1 Cell undervoltage alarm recovery threshold"
    ::= { module1Parameters 4 }

mod1-temp-charge-overheat-alarm-value OBJECT-TYPE
    SYNTAX          Integer32
    UNITS           "Celsius"
    MAX-ACCESS      read-write
    STATUS          current
    DESCRIPTION     "Module 1 Temperature charge overheat alarm threshold (40-60)"
    ::= { module1Parameters 5 }

mod1-soc-low-alarm-value OBJECT-TYPE
    SYNTAX          Unsigned32
    UNITS           "percent"
    MAX-ACCESS      read-write
    STATUS          current
    DESCRIPTION     "Module 1 SOC low alarm threshold (5-30%)"
    ::= { module1Parameters 6 }

