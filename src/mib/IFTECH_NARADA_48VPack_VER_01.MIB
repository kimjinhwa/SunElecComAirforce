    SYNTAX          Integer32
    UNITS           "Celsius"
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION     "Module 1 Temperature sensor 1 (-30 to 120 Celsius)"
    ::= { module1Temperature 1 }

